{
  "name": "@yavona/invariant",
  "version": "0.3.0-alpha.1",
  "description": "Invariant — Test payment webhook scenarios and observe application state assertions locally.",
  "main": "src/index.js",
  "bin": {
    "invariant": "src/index.js",
    "yavona-invariant": "src/index.js"
  },
  "homepage": "https://yavonalabs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yavonalabs/invariant.git"
  },
  "bugs": {
